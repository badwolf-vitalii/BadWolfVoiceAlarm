<Window x:Class="BadWolfVoiceAlarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BadWolf Voice Alarm" Width="800" Height="740"
        MinWidth="640" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220" Foreground="#E5E7EB"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151F31" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#94A3B8" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B7C5D9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1727" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#35435A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#F8FAFC" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0E1727" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#35435A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CFD8E7" />
            <Setter Property="Margin" Value="0,0,0,11" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#30425F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#111B2D" BorderBrush="#27364B" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BADWOLF  /  VOICE ALARM" FontSize="21" FontWeight="Bold" />
                    <TextBlock Text="A Discord voice-channel join triggers a local PC alarm."
                               Foreground="#99A9BD" Margin="0,5,0,0" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1B3141" CornerRadius="10"
                        Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Width="9" Height="9" Fill="#F59E0B"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#C4D3E5"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,19,24,18">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Discord connection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <TextBlock Text="Bot token" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="BotTokenInput" />
                        <TextBlock Text="Stored locally with Windows user-account encryption. Never share this token."
                                   Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,7,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Server ID (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="GuildIdInput" ToolTip="Leave empty to monitor all servers the bot belongs to." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Voice-channel IDs (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ChannelIdsInput" ToolTip="Comma-separated IDs. Leave empty for every voice channel." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Leave filters empty to monitor all voice channels the bot can access."
                                   Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="18" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Alarm behavior" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <CheckBox x:Name="AlertOnMovesCheckBox" Content="Also trigger when someone moves between voice channels" />
                        <CheckBox x:Name="IgnoreBotsCheckBox" Content="Ignore other Discord bots" />
                        <CheckBox x:Name="ForceMaxVolumeCheckBox" Content="Temporarily set selected device volume to 100% and unmute" />
                        <TextBlock Text="Audio output device" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AudioOutputDeviceComboBox" Grid.Column="0"
                                      VerticalContentAlignment="Center"
                                      Height="38" Padding="9,6"
                                      Background="#F8FAFC" Foreground="#111827"
                                      BorderBrush="#35435A" BorderThickness="1"
                                      DisplayMemberPath="DisplayName">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#111827" />
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="Padding" Value="9,6" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Grid.Column="2" Content="Refresh devices"
                                    Click="RefreshAudioDevicesButton_Click" />
                        </Grid>
                        <TextBlock Text="The selected device is used for new alarms and Test alarm."
                                   Foreground="{StaticResource SubtleBrush}" FontSize="11"
                                   Margin="0,0,0,13" TextWrapping="Wrap" />
                        <CheckBox x:Name="AutoConnectCheckBox" Content="Connect automatically when this application starts" />
                        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="Launch with Windows (after signing in)" />
                        <TextBlock Text="The sound loops until you press Stop Alarm. The previous volume/mute state is restored."
                                   Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="ConnectButton" Content="Connect bot" Background="#2563EB"
                            Margin="0,0,9,9" Click="ConnectButton_Click" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" IsEnabled="False"
                            Margin="0,0,9,9" Click="DisconnectButton_Click" />
                    <Button Content="Save settings" Margin="0,0,9,9" Click="SaveSettingsButton_Click" />
                    <Button Content="Test alarm" Background="#5B446B" Margin="0,0,0,9" Click="TestAlarmButton_Click" />
                </WrapPanel>

                <Border x:Name="AlarmPanel" Background="#321C2A" BorderBrush="#75405B"
                        BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="LOCAL ALARM" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" />
                            <TextBlock x:Name="AlarmText" Text="No active alarm" FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="StopAlarmButton" Grid.Column="1" Content="STOP ALARM"
                                Background="#DC2626" IsEnabled="False" Padding="18,13"
                                Click="StopAlarmButton_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="Event log" FontSize="16" FontWeight="SemiBold" Margin="0,19,0,9" />
                <TextBox x:Name="EventLogText" Height="150" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#111B2D" BorderBrush="#27364B" BorderThickness="0,1,0,0"
                Padding="24,11">
            <TextBlock Text="Closing or minimizing hides the app in the notification area. Use its tray menu to stop the alarm or exit."
                       Foreground="#93A3B9" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
